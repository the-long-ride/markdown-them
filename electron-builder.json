{
  "appId": "com.thelongride.markdown-them",
  "productName": "Markdown Them",
  "directories": {
    "app": "dist/desktop",
    "output": "dist/installers"
  },
  "files": [
    "**/*",
    "!**/*.map"
  ],
  "extraMetadata": {
    "main": "main.js"
  },
  "compression": "maximum",
  "electronLanguages": ["en-US", "vi", "zh-CN", "ja", "sv", "es", "fr", "ko"],
  "npmRebuild": false,
  "win": {
    "target": [
      {
        "target": "portable",
        "arch": ["x64"]
      }
    ],
    "icon": "assets/markdown-them-logo.png",
    "artifactName": "markdown-them-${version}-windows-portable.${ext}"
  },
  "mac": {
    "target": ["dmg", "zip"],
    "icon": "assets/markdown-them-logo.png",
    "artifactName": "markdown-them-${version}-mac.${ext}"
  },
  "linux": {
    "target": ["AppImage", "deb"],
    "icon": "assets/markdown-them-logo.png",
    "maintainer": "the-long-ride <thelong1406@gmail.com>",
    "category": "Utility",
    "artifactName": "markdown-them-${version}-linux.${ext}"
  }
}
