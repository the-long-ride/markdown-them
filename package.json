{
  "name": "markdown-them",
  "displayName": "Markdown Them",
  "description": "Convert docx, doc, pdf, html, xlsx, xls, xlm, pptx, odt, odp, ods, rtf files to markdown in your VS Code's explorer or editor.",
  "version": "1.4.0",
  "icon": "assets/markdown-them-logo.png",
  "publisher": "the-long-ride",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/the-long-ride/markdown-them.git"
  },
  "license": "MIT",
  "engines": {
    "vscode": "^1.80.0"
  },
  "categories": [
    "Other",
    "Formatters"
  ],
  "main": "./out/extension.js",
  "activationEvents": [],
  "contributes": {
    "commands": [
      {
        "command": "markdown-them.convertToMarkdown",
        "title": "Convert to Markdown"
      },
      {
        "command": "markdown-them.convertCurrentToMarkdown",
        "title": "Convert Current File to Markdown"
      },
      {
        "command": "markdown-them.setMaxConcurrentConversions",
        "title": "Markdown Them: Set Max Concurrent Conversions"
      }
    ],
    "menus": {
      "explorer/context": [
        {
          "command": "markdown-them.convertToMarkdown",
          "group": "navigation",
          "when": "resourceExtname =~ /\\.(docx|doc|pdf|html|xlsx|xls|xlm|pptx|odt|odp|ods|rtf)$/i"
        }
      ]
    },
    "keybindings": [
      {
        "command": "markdown-them.convertCurrentToMarkdown",
        "key": "ctrl+m ctrl+d",
        "mac": "cmd+m cmd+d"
      },
      {
        "command": "markdown-them.convertToMarkdown",
        "key": "ctrl+alt+m",
        "mac": "cmd+alt+m"
      }
    ],
    "configuration": {
      "title": "Markdown Them",
      "properties": {
        "markdown-them.maxConcurrentConversions": {
          "type": "integer",
          "default": 6,
          "minimum": 1,
          "maximum": 16,
          "description": "Maximum number of files converted simultaneously when using 'Convert to Markdown'. Range: 1–16."
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run bundle:vscode",
    "compile": "tsc -p ./",
    "typecheck:apps": "tsc -p ./tsconfig.app.json",
    "watch": "tsc -watch -p ./",
    "lint:loc": "node scripts/loc-lint.mjs",
    "format:check": "npx prettier --check . && cargo fmt --manifest-path src-tauri/Cargo.toml -- --check",
    "format": "npx prettier --write . && cargo fmt --manifest-path src-tauri/Cargo.toml",
    "test": "node scripts/run-all-tests.mjs",
    "test:coverage": "node scripts/test-coverage.mjs",
    "test:e2e": "node tests/e2e/run-e2e.mjs",
    "test:cli": "node tests/e2e/run-e2e.mjs --tier=5",
    "bundle:vscode": "esbuild ./src/vscode/extension.ts --bundle --outfile=out/extension.js --external:vscode --format=cjs --platform=node --minify",
    "bundle": "npm run bundle:vscode",
    "build:web": "node scripts/build-apps.mjs web",
    "build:desktop": "tauri build",
    "build:apps": "node scripts/build-apps.mjs all",
    "tauri": "tauri",
    "dev:desktop": "tauri dev",
    "start:desktop": "tauri dev",
    "dist:desktop": "tauri build --no-bundle && node scripts/copy-installers.mjs",
    "dist:desktop:win": "tauri build --no-bundle && node scripts/copy-installers.mjs",
    "dist:desktop:linux": "tauri build --bundles deb && node scripts/copy-installers.mjs",
    "dist:desktop:mac": "tauri build --bundles app && node scripts/copy-installers.mjs",
    "dist:desktop:all": "node scripts/copy-installers.mjs",
    "clean:desktop": "cargo clean --manifest-path src-tauri/Cargo.toml && node -e \"require('fs').rmSync('dist/web',{recursive:true,force:true})\"",
    "start:web": "node scripts/start-web.mjs",
    "clean:node-package": "node -e \"require('fs').rmSync('nodejs-package/dist',{recursive:true,force:true})\"",
    "build:node-package": "npm run clean:node-package && tsc -p ./tsconfig.node-package.json",
    "prepare:artifacts": "node -e \"require('fs').mkdirSync('artifacts',{recursive:true})\"",
    "pack:node-package": "npm run build:node-package && npm run prepare:artifacts && npm pack ./nodejs-package --pack-destination ./artifacts",
    "pack:vsix": "vsce package --no-dependencies",
    "pack:all": "npm run pack:vsix && npm run pack:node-package",
    "publish:vsix": "npm run pack:vsix"
  },
  "devDependencies": {
    "@opendocsg/pdf2md": "^0.2.6",
    "@tauri-apps/api": "^2.12.4",
    "@tauri-apps/cli": "^2.12.4",
    "@types/node": "^25.6.0",
    "@types/react": "^19.2.15",
    "@types/react-dom": "^19.2.3",
    "@types/turndown": "^5.0.6",
    "@types/vscode": "^1.80.0",
    "@vscode/vsce": "^4.1.0",
    "c8": "12.0.0",
    "esbuild": "^0.28.1",
    "fast-xml-parser": "^5.8.0",
    "jszip": "^3.10.1",
    "lucide-react": "^1.17.0",
    "mammoth": "^1.12.0",
    "officeparser": "^8.5.0",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "turndown": "^7.2.4",
    "typescript": "^6.0.3"
  },
  "resolutions": {
    "fast-uri": "^3.1.2",
    "tmp": "^0.2.4",
    "fast-csv": "^4.3.6"
  },
  "overrides": {
    "pdfjs-dist": "^6.2.108",
    "minimatch": "^11.0.1",
    "glob": "^14.0.3"
  },
  "keywords": [],
  "author": "",
  "type": "commonjs",
  "bugs": {
    "url": "https://github.com/the-long-ride/markdown-them/issues"
  },
  "homepage": "https://the-long-ride.github.io/markdown-them"
}
