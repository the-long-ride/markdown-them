{
  "name": "@the-long-ride/markdown-them",
  "version": "1.3.2",
  "description": "Convert docx, doc, pdf, html, xlsx, xls, xlm, pptx, odt, odp, ods, rtf files to markdown.",
  "keywords": [
    "markdown",
    "markdown-converter",
    "document-converter",
    "docx",
    "doc",
    "pdf",
    "html",
    "xlsx",
    "xls",
    "xlm",
    "pptx",
    "odt",
    "odp",
    "ods",
    "rtf",
    "office",
    "office-documents",
    "local-first"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/the-long-ride/markdown-them.git"
  },
  "homepage": "https://the-long-ride.github.io/markdown-them",
  "bugs": {
    "url": "https://github.com/the-long-ride/markdown-them/issues"
  },
  "main": "./dist/nodejs-package/index.js",
  "types": "./dist/nodejs-package/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/nodejs-package/index.d.ts",
      "require": "./dist/nodejs-package/index.js",
      "default": "./dist/nodejs-package/index.js"
    }
  },
  "files": [
    "dist/**/*",
    "README.md",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "@opendocsg/pdf2md": "^0.2.6",
    "fast-xml-parser": "^5.8.0",
    "jszip": "^3.10.1",
    "mammoth": "^1.12.0",
    "officeparser": "^7.5.1",
    "turndown": "^7.2.4"
  },
  "overrides": {
    "pdfjs-dist": "6.2.108"
  }
}
