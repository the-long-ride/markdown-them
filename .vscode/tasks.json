{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "tauri dev",
      "type": "shell",
      "command": "npm",
      "args": ["run", "dev:desktop"],
      "isBackground": true,
      "options": {
        "env": {
          "WEBVIEW2_ADDITIONAL_BROWSER_ARGUMENTS": "--remote-debugging-port=9222"
        }
      },
      "problemMatcher": {
        "owner": "tauri",
        "pattern": {
          "regexp": "^$"
        },
        "background": {
          "activeOnStart": true,
          "beginsPattern": ".*(dev:desktop|start:web|tauri dev).*",
          "endsPattern": ".*(Running|Watching|ready|Markdown Them web app).*"
        }
      },
      "presentation": {
        "reveal": "always",
        "panel": "dedicated"
      }
    },
    {
      "label": "app: start web",
      "type": "shell",
      "command": "npm",
      "args": ["run", "start:web"],
      "isBackground": true,
      "problemMatcher": {
        "owner": "markdown-them-web",
        "pattern": {
          "regexp": "^$"
        },
        "background": {
          "activeOnStart": true,
          "beginsPattern": ".*start:web.*",
          "endsPattern": "Markdown Them web app: http://127\\.0\\.0\\.1:\\d+"
        }
      },
      "presentation": {
        "reveal": "always",
        "panel": "dedicated"
      }
    },
    {
      "type": "npm",
      "script": "watch",
      "problemMatcher": "$tsc-watch",
      "isBackground": true,
      "dependsOn": "npm: compile",
      "presentation": {
        "reveal": "never"
      },
      "group": {
        "kind": "build",
        "isDefault": true
      }
    },
    {
      "type": "npm",
      "script": "compile",
      "problemMatcher": "$tsc",
      "presentation": {
        "reveal": "silent"
      }
    }
  ]
}
