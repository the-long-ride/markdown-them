{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "app: build desktop",
      "type": "shell",
      "command": "npm",
      "args": [
        "run",
        "build:desktop",
        "--",
        "--development"
      ],
      "problemMatcher": [],
      "presentation": {
        "reveal": "silent",
        "panel": "dedicated"
      }
    },
    {
      "label": "app: start web",
      "type": "shell",
      "command": "npm",
      "args": [
        "run",
        "start:web"
      ],
      "isBackground": true,
      "problemMatcher": {
        "owner": "markdown-them-web",
        "pattern": {
          "regexp": "^$"
        },
        "background": {
          "activeOnStart": true,
          "beginsPattern": ".*start:web.*",
          "endsPattern": "Markdown Them web app: http://127\\.0\\.0\\.1:5173"
        }
      },
      "presentation": {
        "reveal": "always",
        "panel": "dedicated"
      }
    },
    {
      "type": "npm",
      "script": "watch",
      "problemMatcher": "$tsc-watch",
      "isBackground": true,
      "dependsOn": "npm: compile",
      "presentation": {
        "reveal": "never"
      },
      "group": {
        "kind": "build",
        "isDefault": true
      }
    },
    {
      "type": "npm",
      "script": "compile",
      "problemMatcher": "$tsc",
      "presentation": {
        "reveal": "silent"
      }
    }
  ]
}
